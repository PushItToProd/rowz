              "name": "Payout per Minute",
              "type": "formula",
              "formula": "=XLOOKUP([Race], Races[Race Name], Races[Payout w Bonus]) / [Duration]"
            },
            {
              "name": "Races per hour",
              "type": "formula",
              "formula": "=60 / [Duration]"
            },
            {
              "name": "Races in 8 hours",
              "type": "formula",
              "formula": "=FLOOR(8 * 60 / [Duration])"
            },
            {
              "name": "Races in 5 8hr days",
              "type": "formula",
              "formula": "=5 * [Races in 8 hours]"
            },
            {
              "name": "Payout (40 hrs)",
              "type": "formula",
              "formula": "=[Races in 5 8hr days] * XLOOKUP([Race], Races[Race Name], Races[Payout w Bonus])"
