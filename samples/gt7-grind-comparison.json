              "row": 0,
              "col": 0,
              "input": "=BUTTON(\"Rebuild Runs from Races\", OVERWRITE(DROP(REDUCE(\"\", SEQUENCE(ROWS(Races[Race Name])), LAMBDA(rows, n, LET(shortest, INDEX(Races[Min Duration], n), minutes, SEQUENCE(INDEX(Races[Max Duration], n) - shortest + 1, 1, shortest), VSTACK(rows, HSTACK(MAP(minutes, LAMBDA(minute, n)), MAP(minutes, LAMBDA(minute, INDEX(Races[Race Name], n))), minutes))))), 1), Runs!A:C))"
