            {
              "name": "Races per hour",
              "type": "formula",
              "formula": "=IFERROR(60 / [Duration], \"\")"
            },
            {
              "name": "Races in 8 hours",
              "type": "formula",
              "formula": "=IFERROR(8 * 60 / [Duration], \"\")"
            },
            {
              "name": "Races in 5 days",
              "type": "formula",
              "formula": "=IFERROR(5 * 8 * 60 / [Duration], \"\")"
            },
            {
              "name": "Payout over 40 hours",
              "type": "formula",
              "formula": "=IFERROR([Payout per minute] * 40 * 60, \"\")"
            }
