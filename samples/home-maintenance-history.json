            {
              "row": 5,
              "col": 1,
              "input": "=IF(OR(B1=\"\",B2=\"\"),\"Choose equipment and date\",BUTTON(\"Record completed task\",DO(APPEND_ROW('Service history'!ServiceLog!A:D,B1,B2,B3,B4),CLEAR(B1),CLEAR(B3),CLEAR(B4))))"
            }
          ],
          "formats": [
            {
              "startRow": 1,
              "endRow": 1,
              "startCol": 1,
              "endCol": 1,
              "format": {
                "numberFormat": "mmm d, yyyy"
              }
            },
            {
              "startRow": 2,
              "endRow": 2,
              "startCol": 1,
              "endCol": 1,
              "format": {
                "numberFormat": "$#,##0.00"
              }
            }
          ]
        }
      ]
    },
