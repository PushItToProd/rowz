              "row": 0,
              "col": 1,
              "input": "200"
            },
            {
              "row": 1,
              "col": 0,
              "input": "Electricity ($/kWh)"
            },
            {
              "row": 1,
              "col": 1,
              "input": "0.18"
            },
            {
              "row": 2,
              "col": 0,
              "input": "Machine wear ($/hour)"
            },
            {
              "row": 2,
              "col": 1,
              "input": "1.4"
            },
            {
              "row": 3,
              "col": 0,
              "input": "Finishing labor ($/hour)"
            },
            {
              "row": 3,
              "col": 1,
              "input": "32"
            },
            {
              "row": 4,
              "col": 0,
              "input": "Failure allowance"
            },
