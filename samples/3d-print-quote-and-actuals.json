              "type": "number"
            },
            {
              "name": "MaterialCost",
              "type": "formula",
              "formula": "=[ActualGrams]/1000*XLOOKUP([Material],'Quote desk'!Materials[Material],'Quote desk'!Materials[PricePerKg])"
            },
            {
              "name": "EnergyCost",
              "type": "formula",
              "formula": "=[PrintHours]*'Quote desk'!RateCard!B1/1000*'Quote desk'!RateCard!B2"
            },
            {
              "name": "MachineWear",
              "type": "formula",
              "formula": "=[PrintHours]*'Quote desk'!RateCard!B3"
            },
            {
              "name": "FinishLabor",
              "type": "formula",
              "formula": "=[FinishHours]*'Quote desk'!RateCard!B4"
            },
            {
              "name": "ActualCost",
              "type": "formula",
              "formula": "=PrintCost([MaterialCost],[EnergyCost],[MachineWear],[FinishLabor])"
            },
            {
              "name": "Difference",
              "type": "formula",
              "formula": "=[ActualCost]-[EstimatedCost]"
            },
