            },
            {
              "name": "FinishHours",
              "type": "number"
            },
            {
              "name": "MaterialCost",
              "type": "formula",
              "formula": "=[Grams]/1000*XLOOKUP([Material],Materials[Material],Materials[PricePerKg])"
            },
            {
              "name": "EnergyCost",
              "type": "formula",
              "formula": "=[PrintHours]*RateCard!B1/1000*RateCard!B2"
            },
            {
              "name": "MachineWear",
              "type": "formula",
              "formula": "=[PrintHours]*RateCard!B3"
            },
            {
              "name": "FinishLabor",
              "type": "formula",
              "formula": "=[FinishHours]*RateCard!B4"
            },
            {
              "name": "DirectCost",
              "type": "formula",
              "formula": "=PrintCost([MaterialCost],[EnergyCost],[MachineWear],[FinishLabor])"
            },
            {
              "name": "FailureAllowance",
              "type": "formula",
              "formula": "=[DirectCost]*RateCard!B5"
            },
            {
              "name": "Markup",
              "type": "formula",
              "formula": "=RateCard!B6"
            },
            {
              "name": "QuotePrice",
              "type": "formula",
              "formula": "=ROUND(([DirectCost]+[FailureAllowance])*(1+[Markup]),2)"
            }
          ],
