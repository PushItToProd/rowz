              "input": "Note"
            },
            {
              "row": 5,
              "col": 0,
              "input": "Record payment"
            },
            {
              "row": 5,
              "col": 1,
              "input": "=IF(OR(B1=\"\",B2=\"\",B3=\"\"),\"Choose an invoice, date, and amount\",BUTTON(\"Record payment\",DO(APPEND_ROW('Records'!Payments!A:D,B1,B2,B3,B4),CLEAR(B3),CLEAR(B4))))"
            }
