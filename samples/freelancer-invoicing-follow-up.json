              "name": "Balance",
              "type": "formula",
              "formula": "=MAX(0,[Total]-[Paid])"
            },
            {
              "name": "Status",
              "type": "formula",
              "formula": "=IF([Balance]=0,\"Paid\",IF([DueDate]<'Invoice desk'!Settings!B1,\"Overdue\",\"Open\"))"
