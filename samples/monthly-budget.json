          "name": "Monthly Totals",
          "rowCount": 4,
          "colCount": 2,
          "cells": [
            { "row": 0, "col": 0, "input": "September summary" },
            { "row": 0, "col": 1, "input": "Amount" },
            { "row": 1, "col": 0, "input": "Income" },
            {
              "row": 1,
              "col": 1,
              "input": "=SUMIFS(Transactions[Amount], Transactions[Kind], \"Income\", Transactions[Date], \">=\"&DATE(2026, 9, 1), Transactions[Date], \"<\"&DATE(2026, 10, 1))"
            },
            { "row": 2, "col": 0, "input": "Expenses" },
            {
              "row": 2,
              "col": 1,
              "input": "=SUMIFS(Transactions[Amount], Transactions[Kind], \"Expense\", Transactions[Date], \">=\"&DATE(2026, 9, 1), Transactions[Date], \"<\"&DATE(2026, 10, 1))"
            },
            { "row": 3, "col": 0, "input": "Net after expenses" },
            { "row": 3, "col": 1, "input": "=B2-B3" }
          ],
