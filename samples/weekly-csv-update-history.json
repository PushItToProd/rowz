              "endRow": null,
              "startCol": 0,
              "endCol": 0,
              "format": {
                "numberFormat": "mmm d, yyyy"
              }
            },
            {
              "startRow": 0,
              "endRow": null,
              "startCol": 4,
              "endCol": 4,
              "format": {
                "numberFormat": "$#,##0.00"
              }
            }
          ]
        },
        {
          "type": "text",
          "name": "Week over week",
          "source": "## Week-over-week report\n\n{% let previous = SUMIFS(Snapshots[MonthlyCost],Snapshots[Week],'Weekly update'!Settings!B2) %}\n{% let current = SUM('Current records'!CurrentRecords[MonthlyCost]) %}\n**Prior week:** {{ TEXT(previous, \"$#,##0.00\") }} · **Current:** {{ TEXT(current, \"$#,##0.00\") }} · **Change:** {{ TEXT(current-previous, \"$#,##0.00;-$#,##0.00\") }}\n\nCurrent rows include per-service cost changes and the new metrics-exporter record. Once saved, this week's snapshot becomes a dated baseline for next week's report."
