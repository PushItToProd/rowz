              "type": "text"
            },
            {
              "name": "Capacity",
              "type": "number"
            },
            {
              "name": "ConfirmedSeats",
              "type": "formula",
              "formula": "=COUNTIFS('Guest list'!Guests[TableName],[TableName],'Guest list'!Guests[RSVP],\"Yes\")"
            },
            {
              "name": "Remaining",
              "type": "formula",
              "formula": "=[Capacity]-[ConfirmedSeats]"
            },
            {
              "name": "CapacityStatus",
              "type": "formula",
              "formula": "=IF([Remaining]<0,\"Over capacity\",\"Seats available\")"
            }
          ],
